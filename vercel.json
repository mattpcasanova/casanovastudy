{
  "functions": {
    "app/api/upload/route.ts": {
      "maxDuration": 30
    },
    "app/api/grade-exam-stream/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/grade-exam/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/grading-suggestions/route.ts": {
      "maxDuration": 10
    },
    "app/api/grade-batch/paper/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/grade-batch/split/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/review-reminders/route.ts": {
      "maxDuration": 300
    },
    "app/api/inbound/scan/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/cron/review-reminders",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/scan-inbox-cleanup",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/error-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/practice-due",
      "schedule": "0 9 * * *"
    }
  ]
}
